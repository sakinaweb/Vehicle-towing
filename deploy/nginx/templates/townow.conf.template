# Rendered by the nginx image (envsubst) from API_DOMAIN / ADMIN_DOMAIN.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# HTTP → HTTPS, except Let's Encrypt HTTP-01 challenges.
server {
  listen 80;
  server_name ${API_DOMAIN} ${ADMIN_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}

# API: REST + Socket.IO (/realtime) + Stripe webhooks.
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};
  ssl_certificate     /etc/nginx/certs/${API_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/${API_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  client_max_body_size 12m; # KYC documents and inspection photos

  location /socket.io/ {
    proxy_pass http://api:4000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass http://api:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}

# Admin dashboard.
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};
  ssl_certificate     /etc/nginx/certs/${ADMIN_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/${ADMIN_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options DENY always;

  location / {
    proxy_pass http://admin:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
