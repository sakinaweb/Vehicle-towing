# TowNow production settings. Copy to deploy/.env, fill in, keep it off git and chmod 600.
# Every value here is a placeholder — none are real credentials.

# ---- Domains (DNS A records → this VPS) ----
API_DOMAIN=api.example.ae
ADMIN_DOMAIN=admin.example.ae
CERTS_DIR=./certs

# ---- App ----
PORT=4000
CORS_ORIGINS=https://admin.example.ae
COOKIE_SECURE=true
SWAGGER_ENABLED=false
TOWNOW_VERSION=latest

# ---- Database / Redis (private network only) ----
DATABASE_NAME=townow
DATABASE_USER=townow
DATABASE_PASSWORD=        # long random value
REDIS_PASSWORD=           # long random value
BACKUP_KEEP_DAYS=14

# ---- Secrets (generate: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=
OTP_SECRET=

# ---- SMS (OTP). "log" is refused in production ----
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER=

# ---- File storage. "local" is refused in production (use a UAE region, e.g. me-central-1) ----
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Maps (ETA + address search; key stays on the server) ----
ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- Push (Firebase service account: project_id, client_email, private_key) ----
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Payments (cash-only by default, per the business model) ----
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Invoices: TRN required before issuing tax invoices ----
INVOICE_SELLER_NAME=TowNow
INVOICE_SELLER_ADDRESS=
INVOICE_TRN=
