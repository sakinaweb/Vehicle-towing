# TowNow API — copy to .env and adjust. Never commit real secrets.
# All values are validated at startup (src/config/env.validation.ts).

NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated browser origins allowed by CORS and Socket.IO (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Interactive docs at /api/docs — disable in production unless protected
SWAGGER_ENABLED=true
# Reverse-proxy hops in front of the API (e.g. 1 behind a load balancer) so client IPs are correct
TRUST_PROXY=0

# PostgreSQL + PostGIS (docker-compose maps the container to host port 5433)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=townow
DATABASE_PASSWORD=change-me
DATABASE_NAME=townow
DATABASE_SSL=false
DATABASE_LOGGING=false

# Redis (cache, presence, BullMQ) — docker-compose maps to host port 6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=townow

# ---- Authentication ----
# Generate each secret with: openssl rand -base64 48   (placeholders are rejected in production)
JWT_ACCESS_SECRET=change-me-access-token-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (cookies over HTTPS only)
COOKIE_SECURE=false

# ---- One-time passcodes ----
OTP_SECRET=change-me-otp-pepper-secret-at-least-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PHONE_HOURLY_LIMIT=5
OTP_IP_HOURLY_LIMIT=30

# ---- SMS delivery ----
# log    = print the SMS to the API log (development only; refused in production)
# twilio        = send our own code via Programmable Messaging (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_SENDER)
# twilio_verify = Twilio Verify issues, sends and checks the code (TWILIO_ACCOUNT_SID + the three values below)
SMS_PROVIDER=log
# Development only: also sign in Indian (+91) test numbers. Needs SMS_PROVIDER=log; refused in production.
DEV_ALLOW_INDIA_PHONES=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 number, registered alphanumeric sender ID, or Messaging Service SID (MG...)
TWILIO_SENDER=
# Twilio Verify (API key auth; the key needs Verify permissions — a Standard key, or a Restricted key granted Verify access)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# ---- Dispatch / matching ----
# Drivers within this radius of the pickup are offered the job (nearest first)
MATCHING_SEARCH_RADIUS_METERS=15000
# Seconds a driver has to accept before the offer moves to the next driver
MATCHING_OFFER_TIMEOUT_SECONDS=30
# Seconds between searches when nobody eligible is nearby
MATCHING_RETRY_DELAY_SECONDS=20
# Give up and cancel ("no tow truck available") after searching this long
MATCHING_MAX_SEARCH_SECONDS=900
# Driver locations older than this are stale (not offered jobs, rejected on upload)
DRIVER_LOCATION_MAX_AGE_SECONDS=120
# Minimum seconds between PostgreSQL writes of a driver's position (Redis always gets the latest)
DRIVER_LOCATION_DB_WRITE_INTERVAL_SECONDS=15
# Online driver with stale GPS: push warning after DRIVER_LOCATION_MAX_AGE_SECONDS, set offline after this (0 = never)
DRIVER_STALE_OFFLINE_SECONDS=600

# ---- File storage (inspection photos, KYC documents) ----
# local = files on this server's disk (development only; refused in production)
# s3    = AWS S3 or any S3-compatible store (Cloudflare R2, MinIO) — requires the S3_* values
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
# Only for S3-compatible stores, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- Routing / ETA (server-side only; never put these keys in the React app) ----
# none   = ETA shown as unavailable (no fake estimates)
# google = Google Routes API (GOOGLE_MAPS_API_KEY) · mapbox = Mapbox Directions (MAPBOX_ACCESS_TOKEN)
ROUTING_PROVIDER=none
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- Payments (Stripe; use TEST keys sk_test_/pk_test_ outside production) ----
# none   = cash only (card / Apple Pay bookings are refused)
# stripe = card / Apple Pay authorised at booking, captured when the tow is completed
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint POST /api/v1/payments/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Unpaid card bookings are cancelled after this many minutes
PAYMENT_AUTH_TIMEOUT_MINUTES=30

# ---- Invoices ----
INVOICE_SELLER_NAME=TowNow
INVOICE_SELLER_ADDRESS=
# 15-digit UAE Tax Registration Number. REQUIRED before issuing production tax invoices;
# until set, documents are issued as receipts marked "not a tax invoice".
INVOICE_TRN=
